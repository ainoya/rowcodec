{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:all"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-5 1 * *"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 1 * *"]
  },
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate",
    "groupName": null
  },
  "osvVulnerabilityAlerts": true
}
